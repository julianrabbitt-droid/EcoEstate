# Copy to .env and fill in. Only the keys for features you use are required.

# Public address of the site (used in emails, Google sign-in and checkout links).
# In development this defaults to http://localhost:5173.
# Leave unset for local development; set it on your live server.
# APP_URL=https://ecoestate-homes.com
PORT=3001

# Comma-separated emails that get the admin role when they sign up.
ADMIN_EMAILS=julianrabbitt@gmail.com

# Property auto-scan (satellite tracing). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Satellite imagery + Street View (Maps Static API and Street View Static API).
GOOGLE_MAPS_API_KEY=

# Optional: property records lookup through RapidAPI's Zillow API.
RAPIDAPI_KEY=
RAPIDAPI_ZILLOW_HOST=zillow-com1.p.rapidapi.com

# Google sign-in: an OAuth client of type "Web application" in Google Cloud Console.
#   Authorized JavaScript origins: http://localhost:5173 and https://ecoestate-homes.com
#   Authorized redirect URIs:      http://localhost:5173/api/auth/google/callback
#                                  https://ecoestate-homes.com/api/auth/google/callback
# On the live server, APP_URL must be https://ecoestate-homes.com so the redirect matches.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for verification codes and password resets, sent through Resend (resend.com).
# Without a key, emails are printed to the server terminal instead.
RESEND_API_KEY=
EMAIL_FROM=EcoEstate <no-reply@ecoestate-homes.com>

# Premium subscription checkout (Wix Payments).
WIX_CHECKOUT_API_KEY=
WIX_CHECKOUT_SITE_ID=
WIX_CHECKOUT_WEBHOOK_PUBLIC_KEY=

# Optional: where the database and uploads live (default ./data).
# DATA_DIR=/var/lib/ecoestate
# Optional: fixed signing secret (otherwise one is generated in DATA_DIR).
# JWT_SECRET=

# Where the lawn-to-native API (lawn-api/) runs. Defaults to http://localhost:<PORT from lawn-api/.env>.
# Its keys (GEOCODIO_API_KEY, APP_API_KEY) belong in lawn-api/.env only.
# LAWN_API_URL=http://localhost:3000

# Stripe: secret key and the webhook signing secret for POST /api/functions/payments-webhook
# (events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
