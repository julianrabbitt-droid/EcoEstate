{
  "name": "Project",
  // Listing saved properties (My properties) is a Pro feature; opening,
  // creating and editing a scan stay free.
  "premiumList": true,
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "description": "Full project record as JSON: address, boundary, breakdown, design, scan imagery URLs, scan estimate contours, site conditions, etc. The entity id is the project id."
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}