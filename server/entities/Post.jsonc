{
  "name": "Post",
  // Pro feature (community or project tracking): only EcoEstate Pro
  // members, student unlocks and admins can use this entity at all.
  "premium": true,
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "body": {
      "type": "string",
      "title": "Body"
    },
    "image_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Image URIs"
    },
    "author_name": {
      "type": "string",
      "title": "Author name",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}