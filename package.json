{
  "name": "ecoestate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,lawn -c green,blue,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:lawn\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server --import tsx server/index.js",
    "dev:web": "vite",
    "dev:lawn": "npm --prefix lawn-api run dev",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx server/index.js",
    "start:production": "node scripts/start-production.mjs",
    "migrate:supabase": "node --disable-warning=ExperimentalWarning server/scripts/migrate-sqlite-to-supabase.mjs",
    "postinstall": "npm --prefix lawn-api install --no-audit --no-fund",
    "lint": "eslint . --quiet",
    "preview": "npm run build && npm start",
    "email:test": "node server/scripts/send-test-emails.mjs",
    "costs": "node --disable-warning=ExperimentalWarning server/scripts/costs.mjs"
  },
