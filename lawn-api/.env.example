# Copy to .env and fill in
PORT=3000

# Required: address lookup (geocod.io). Only needs access to the geocode endpoint.
GEOCODIO_API_KEY=

# Optional: require your app to send this value in an x-api-key header
APP_API_KEY=

# Optional: comma-separated origins allowed to call the API (default: all)
ALLOWED_ORIGINS=

# Impact defaults (can be overridden per request)
DEFAULT_ET0_INCHES=45
DEFAULT_WATER_PRICE=0
DEFAULT_REBATE_PER_SQFT=0

# Canopy height map used to remove trees: v2 (Meta DINOv3, newer, default) or v1 (Meta/WRI)
# CANOPY_VERSION=v2

# How many lawn scans run at once (a full-size scan holds a few hundred MB); up to 8 more wait, the rest get 503 busy
# LAWN_MAX_CONCURRENT=1
